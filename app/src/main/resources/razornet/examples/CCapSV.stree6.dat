BEGIN ALGORITHM;
TITLE 'Razor Haplo Net';
LINK CHARACTERS = 'Working Characters';
NAME 'Razor Haplo Net';
OPTIONS
	Strategy = 'Both',
	Labeling = 'MinExcess',
	RemoveSuperfluous = 'true',
	ContractUnlabeled = 'true',
	MissingAsState = 'false',
	MaskGapSites = 'false',
	MaxSeconds = 60;
END; [ALGORITHM]

