BEGIN SPLITS;
TITLE 'Splits';
LINK ALGORITHM = 'Neighbor Net';
DIMENSIONS ntax=9 nsplits=17;
FORMAT labels=no weights=yes confidences=no;
PROPERTIES fit=99.3 circular;
CYCLE 1 3 2 9 6 8 7 4 5;
MATRIX
