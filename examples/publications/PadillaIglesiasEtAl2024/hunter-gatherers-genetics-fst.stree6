BEGIN ALGORITHM;
TITLE 'Razor Net';
LINK DISTANCES = 'Working Distances';
NAME 'Razor Net';
OPTIONS
	Preprocessing = 'None',
	Strategy = 'Both',
	SignificantDigits = 6,
	MaxSeconds = 60;
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Neighbor Net';
LINK DISTANCES = 'Working Distances';
NAME 'Neighbor Net';
OPTIONS
	InferenceAlgorithm = 'ActiveSet';
END; [ALGORITHM]

BEGIN NETWORK;
TITLE 'Network';
LINK ALGORITHM = 'Razor Net';
DIMENSIONS nVertices=14 nEdges=14;
TYPE DistanceNetwork;
