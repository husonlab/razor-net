	Strategy = 'Both',
	SignificantDigits = 6,
	MaxSeconds = 60;
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Neighbor Net';
LINK DISTANCES = 'Working Distances';
NAME 'Neighbor Net';
OPTIONS
	InferenceAlgorithm = 'ActiveSet';
END; [ALGORITHM]

