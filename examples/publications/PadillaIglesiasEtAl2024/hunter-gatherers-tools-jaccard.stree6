BEGIN ALGORITHM;
TITLE 'Show Network';
LINK NETWORK = 'Network';
NAME 'Show Network';
OPTIONS
	View = 'Network';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Simplify Filter';
LINK NETWORK = 'Network';
NAME 'Simplify Filter';
OPTIONS
	Target = 'Balanced',
	TargetValue = 0,
	Deviation = 'Auto',
	DeviationQuantilePercent = 100,
	ReportTable = 'true';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Show Splits';
LINK SPLITS = 'Splits';
NAME 'Show Splits';
OPTIONS
	View = 'SplitNetwork';
END; [ALGORITHM]

