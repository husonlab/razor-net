	[1] 'Aka'
	[2] 'Babongo'
	[3] 'Baka'
	[4] 'Bakola'
	[5] 'Bakoya'
	[6] 'Batwa (East)'
	[7] 'Batwa (West)'
	[8] 'Bedzan'
	[9] 'Efe'
	[10] 'Sua'
;
[DISPLAYLABELS;]
[TAXINFO;]
