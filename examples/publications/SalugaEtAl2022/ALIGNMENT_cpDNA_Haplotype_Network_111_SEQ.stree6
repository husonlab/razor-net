BEGIN ALGORITHM;
TITLE 'Razor Haplo Net';
LINK CHARACTERS = 'Working Characters';
NAME 'Razor Haplo Net';
OPTIONS
	Strategy = 'Both',
	Labeling = 'MinExcess',
	RemoveSuperfluous = 'true',
	ContractUnlabeled = 'true',
	MissingAsState = 'false',
	MaxStretchPercent = 0,
	MaxSeconds = 60;
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Median Joining';
LINK CHARACTERS = 'Working Characters';
NAME 'Median Joining';
OPTIONS
	Epsilon = 0;
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'TCS Haplotype Network';
LINK CHARACTERS = 'Working Characters';
NAME 'TCS Haplotype Network';
OPTIONS
	RemoveSuperfluous = 'true',
	ContractUnlabeled = 'true',
	Labeling = 'MinExcess',
	MissingAsState = 'false',
	MaxSeconds = 60;
END; [ALGORITHM]

BEGIN NETWORK;
