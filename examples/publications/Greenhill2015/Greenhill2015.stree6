BEGIN ALGORITHM;
TITLE 'Show Network';
LINK NETWORK = 'Network';
NAME 'Show Network';
OPTIONS
	View = 'Network';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Shave Filter';
LINK NETWORK = 'Network';
NAME 'Shave Filter';
OPTIONS
	Target = 'Balanced',
	TargetValue = 0,
	Deviation = 'Auto',
	DeviationQuantilePercent = 100,
	ReportTable = 'true';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Show Splits';
LINK SPLITS = 'Splits';
NAME 'Show Splits';
OPTIONS
	View = 'SplitNetwork';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'Network-2';
LINK ALGORITHM = 'Show Network';
NAME 'NetworkView';
INPUT 'NETWORK';
OPTIONS
	Diagram = 'Network',
	FontScaleFactor = 1,
	TraitLegend = 'False',
