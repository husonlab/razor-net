BEGIN ALGORITHM;
TITLE 'Neighbor Net';
LINK DISTANCES = 'Distances';
NAME 'Neighbor Net';
OPTIONS
	InferenceAlgorithm = 'ActiveSet';
END; [ALGORITHM]

BEGIN SPLITS;
