BEGIN CHARACTERS;
TITLE 'Input Characters';
LINK ALGORITHM = 'Input Data Loader';
DIMENSIONS ntax=14 nchar=391;
FORMAT
	datatype='Standard' missing=? gap=- symbols="01" labels=left transpose=no interleave=no;
MATRIX
Borong  
Burum   
Dedua   
Kate    
Komba   
Kube    
Mape    
Mesem   
Mindik  
Nabak   
Ono     
Selepet 
Timbe   
Tobo    
;
END; [CHARACTERS]

BEGIN ALGORITHM;
TITLE 'Input Data Filter';
LINK CHARACTERS = 'Input Characters';
NAME 'Characters Taxa Filter';
OPTIONS
;
END; [ALGORITHM]

BEGIN CHARACTERS;
TITLE 'Working Characters';
LINK ALGORITHM = 'Input Data Filter';
DIMENSIONS ntax=14 nchar=391;
FORMAT
	datatype='Standard' missing=? gap=- symbols="01" labels=left transpose=no interleave=no;
MATRIX
Borong  
Burum   
Dedua   
Kate    
Komba   
Kube    
Mape    
Mesem   
Mindik  
Nabak   
Ono     
Selepet 
Timbe   
Tobo    
;
END; [CHARACTERS]

BEGIN ALGORITHM;
TITLE 'Hamming Distance';
LINK CHARACTERS = 'Working Characters';
NAME 'Hamming Distance';
OPTIONS
	MatchAmbiguityCodes = 'true',
	MatchGapToGap = 'false';
END; [ALGORITHM]

BEGIN DISTANCES;
TITLE 'Distances';
LINK ALGORITHM = 'Hamming Distance';
DIMENSIONS ntax=14;
FORMAT labels=left diagonal triangle=Both;
