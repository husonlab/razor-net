BEGIN ALGORITHM;
TITLE 'Show Splits';
LINK SPLITS = 'Splits';
NAME 'Show Splits';
OPTIONS
	View = 'SplitNetwork';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'SplitNetwork';
LINK ALGORITHM = 'Show Splits';
NAME 'SplitNetworkView';
INPUT 'SPLITS';
OPTIONS
	Diagram = 'Splits',
	Orientation = 'FlipRotate100Deg',
	Rooting = 'None',
	ZoomFactor = 0.65189992,
	FontScaleFactor = 1,
	RootAngle = 160,
	OutlineFill = 0xffe6b3ff,
	LabelSplitsBy = 'None',
	ShowQRCode = 'false';
END; [VIEW]
