BEGIN ALGORITHM;
TITLE 'Show Network';
LINK NETWORK = 'Network';
NAME 'Show Network';
OPTIONS
	View = 'Network';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Show Network-2';
LINK NETWORK = 'Network-2';
NAME 'Show Network';
OPTIONS
	View = 'Network';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'Network';
LINK ALGORITHM = 'Show Network';
NAME 'NetworkView';
INPUT 'NETWORK';
OPTIONS
	Diagram = 'Network',
	FontScaleFactor = 1,
	ActiveTraits = 'Europe' 'Asia' 'Africa' 'Australia' 'America',
	TraitLegend = 'False',
	TraitSize = 32,
	SitesStyle = 'Labels',
	Edits = 'mn:1:-83.31,27.39' 'mn:2:131.13,190.78' 'mn:3:-43.74,-36.59' 'mn:4:60.91,62.89' 'mn:5:-64.3,129.94' 'mn:6:-78.62,-31.06' 'mn:7:-68.09,-61.63' 'mn:8:11.73,-67.62' 'mn:9:-206.66,-67.87' 'mn:10:75.36,35.39' 'mn:11:-6.7,-34.74' 'mn:12:110.68,27.84',
	LayoutSeed = 1;
END; [VIEW]

BEGIN VIEW;
