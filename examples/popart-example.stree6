	id=9 states='ATATACGGGGATAAAAGTAGAAAAAAAAATGTGTGTGTGTTTTTTTTTTCATGTGA',
	id=10 states='ATATACGGGGATAAAATTAGAAAAAAGAATGTGTGTGTGTTTTTTTTTTCATGTGA',
	id=11 states='ATATACGGGGATAAAAGTAGAAAAAAAAATGTGTGTGTGTTTTTTTTTTCATGTGA',
	id=12 states='ATATACGGGGATAAAATTAGAAAAAAAAATGTGTGTGTGTTTTTTTTTTCATGTGA'
;
EDGES
	id=1 sid=1 tid=12 weight='1' sites='11,56',
	id=2 sid=2 tid=10 weight='5.5' sites='20,31,33,37,40,44,56',
