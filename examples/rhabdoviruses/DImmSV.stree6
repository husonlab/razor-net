BEGIN ALGORITHM;
TITLE 'Razor Haplo Net';
LINK CHARACTERS = 'Working Characters';
NAME 'Razor Haplo Net';
OPTIONS
	RandomRestarts = 1000,
	MaxPolishRounds = 1,
	RemoveRedundant = 'true',
	RemoveSuperfluous = 'true',
	ContractUnlabeled = 'true',
	Labeling = 'MinExcess',
	RandomSeed = 42,
	MaxSeconds = 60;
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Median Joining';
LINK CHARACTERS = 'Working Characters';
NAME 'Median Joining';
OPTIONS
	Epsilon = 0;
END; [ALGORITHM]

