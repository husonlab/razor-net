BEGIN ALGORITHM;
TITLE 'Razor Net';
LINK DISTANCES = 'Working Distances';
NAME 'Razor Net';
OPTIONS
	Preprocessing = 'None',
	Strategy = 'Both',
	SignificantDigits = 6,
	MaxSeconds = 60;
END; [ALGORITHM]

