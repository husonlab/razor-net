BEGIN TRAITS;
DIMENSIONS [nTax=19] nTraits=2;
FORMAT labels=yes missing=? separator=Comma;
TRAITLATITUDE 31.7917 35.2401;
TRAITLONGITUDE -7.0926 24.8093;
TRAITLABELS
