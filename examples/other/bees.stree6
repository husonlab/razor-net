BEGIN ALGORITHM;
TITLE 'Show Network';
LINK NETWORK = 'Network';
NAME 'Show Network';
OPTIONS
	View = 'Network';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'Network';
LINK ALGORITHM = 'Show Network';
NAME 'NetworkView';
INPUT 'NETWORK';
OPTIONS
	Diagram = 'Network',
	FontScaleFactor = 1,
	TraitLegend = 'False',
	TraitSize = 32,
	SitesStyle = 'Hatches',
	Edits = 'mn:3:-186.05,69.95',
	LayoutSeed = 1;
END; [VIEW]
