BEGIN ALGORITHM;
TITLE 'Razor Haplo Net';
LINK CHARACTERS = 'Working Characters';
NAME 'Razor Haplo Net';
OPTIONS
	DistanceMethod = 'Hamming',
	RandomRestarts = 100,
	MaxPolishRounds = 10,
	RemoveRedundant = 'true',
	RemoveSuperfluous = 'true',
	ContractUnlabeled = 'true',
	RandomSeed = 0;
END; [ALGORITHM]

BEGIN NETWORK;
TITLE 'Network';
LINK ALGORITHM = 'Razor Haplo Net';
DIMENSIONS nVertices=10 nEdges=9;
TYPE HaplotypeNetwork;
PROPERTIES info ='Total length: 188, excess: 109';
VERTICES
	id=1 label='A.andrenof' states='',
	id=2 label='A.mellifer' states='',
	id=3 label='A.dorsata' states='',
	id=4 label='A.cerana' states='',
	id=5 label='A.florea' states='',
	id=6 label='A.koschev' states='',
	id=10 states='',
	id=11 states='',
	id=14 states='',
	id=15 states=''
;
EDGES
	id=1 sid=1 tid=14 weight='0.5' sites='63,87,273,652',
	id=2 sid=2 tid=10 weight='22.5' sites='6,15,44,81,114,117,161,166,168,207,211,217,279,288,333,367,377,378,387,396,400,421,423,429,438,441,442,447,456,486,495,501,558,625,636,643,663,674,675',
