#nexus [SplitsTree6]

BEGIN SPLITSTREE6;
DIMENSIONS nDataNodes=8 nAlgorithms=5;
PROGRAM version='SplitsTree App (version 6.7.6, built 16 Mar 2026)';
WORKFLOW creationDate='1777387829778'; [Tue Apr 28 16:50:29 CEST 2026]
END; [SPLITSTREE6]

[
Methods:
Analysis was performed using SplitsTree App 6.0.0 (Huson and Bryant 2024).
The original input consisted of 6 taxa and 6 DNA sequences of length 677.
The Razor Haplo Net method was used (default options) so as to obtain 10 nodes and 9 edges.

References:
Huson and Bryant 2024: D.H. Huson and D. Bryant. The SplitsTree App: interactive analysis and visualization using phylogenetic trees and networks. Nature Methods, 2024.
]

BEGIN TAXA;
TITLE 'Input Taxa';
LINK ALGORITHM = 'Input Data Loader';
DIMENSIONS ntax=6;
TAXLABELS
	[1] 'A.andrenof'
	[2] 'A.mellifer'
	[3] 'A.dorsata'
	[4] 'A.cerana'
	[5] 'A.florea'
	[6] 'A.koschev'
;
[DISPLAYLABELS;]
[TAXINFO;]
END; [TAXA]

BEGIN ALGORITHM;
TITLE 'Taxa Filter';
LINK ALGORITHM = 'Input Data Loader';
NAME 'Taxa Filter';
OPTIONS
;
END; [ALGORITHM]

BEGIN TAXA;
TITLE 'Working Taxa';
LINK ALGORITHM = 'Taxa Filter';
DIMENSIONS ntax=6;
TAXLABELS
	[1] 'A.andrenof'
	[2] 'A.mellifer'
