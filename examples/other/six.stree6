BEGIN ALGORITHM;
TITLE 'Show Splits';
LINK SPLITS = 'Splits';
NAME 'Show Splits';
OPTIONS
	View = 'SplitNetwork';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Show Network';
LINK NETWORK = 'Network';
NAME 'Show Network';
OPTIONS
	View = 'Network';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'SplitNetwork';
LINK ALGORITHM = 'Show Splits';
NAME 'SplitNetwork';
INPUT 'SPLITS';
OPTIONS
	Diagram = 'Splits',
	Orientation = 'Rotate0Deg',
	Rooting = 'None',
	ZoomFactor = 1,
	FontScaleFactor = 1,
	RootAngle = 160,
	OutlineFill = 0xffe6b3ff,
	LabelSplitsBy = 'None',
	ShowQRCode = 'false';
END; [VIEW]

BEGIN VIEW;
TITLE 'Network';
LINK ALGORITHM = 'Show Network';
NAME 'Network';
INPUT 'NETWORK';
OPTIONS
	Diagram = 'Network',
	FontScaleFactor = 1,
	TraitLegend = 'False',
	TraitSize = 32,
	SitesStyle = 'Weights',
	Edits = 'mn:1:-181.47,-140.2' 'mn:2:-35.99,-135.62' 'mn:3:119.16,-127.02' 'mn:4:151.02,93.48' 'mn:5:-187.43,58.62' 'mn:6:66.49,171.6' 'mn:7:-62.36,-3.8' 'mn:8:-12.17,-55.81' 'mn:9:-27.86,12.28' 'mn:10:30.18,-46.64' 'mn:11:72.74,-51.17' 'mn:12:75.29,38.77' 'mn:13:-12.16,54.39' 'mn:14:-51.26,43.15' 'mn:15:-82.66,13.13' 'mn:16:11.4,25.07' 'mn:17:40.38,50.51' 'mn:18:83.77,-2.42' 'mn:19:-92.44,64.67' 'mn:20:2.83,-40.11' 'mn:21:114.62,14.7' 'mn:22:55.47,-16.12',
	LayoutSeed = 680;
END; [VIEW]
