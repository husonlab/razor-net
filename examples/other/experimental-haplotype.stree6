BEGIN ALGORITHM;
TITLE 'Show Network';
LINK NETWORK = 'Network';
NAME 'Show Network';
OPTIONS
	View = 'Network';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Show Network';
LINK NETWORK = 'Network-2';
NAME 'Show Network';
OPTIONS
	View = 'Network';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'Network';
LINK ALGORITHM = 'Show Network';
NAME 'Network';
INPUT 'NETWORK';
OPTIONS
	Diagram = 'Network',
	FontScaleFactor = 1,
	ActiveTraits = 'Europe' 'Asia' 'Africa' 'Australia' 'America',
	TraitLegend = 'False',
	TraitSize = 32,
	SitesStyle = 'Hatches';
END; [VIEW]

BEGIN VIEW;
TITLE 'Network';
LINK ALGORITHM = 'Show Network';
NAME 'Network';
INPUT 'NETWORK';
OPTIONS
	Diagram = 'Network',
	FontScaleFactor = 1,
	ActiveTraits = 'Europe' 'Asia' 'Africa' 'Australia' 'America',
	TraitLegend = 'False',
	TraitSize = 32,
