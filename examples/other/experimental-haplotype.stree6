#nexus [SplitsTree6]

BEGIN SPLITSTREE6;
DIMENSIONS nDataNodes=11 nAlgorithms=6;
PROGRAM version='SplitsTree App (version 6.5.1-j8, built 27 Sep 2025)';
WORKFLOW creationDate='1759016749950'; [Sun Sep 28 08:45:49 JST 2025]
END; [SPLITSTREE6]

[!
Source: http://popart.otago.ac.nz/examplenex.shtml
This is an example of a Nexus file, modified from a sample file distributed
with DNASP.]

[
Input:
Source: http://popart.otago.ac.nz/examplenex.shtml
This is an example of a Nexus file, modified from a sample file distributed
with DNASP.

Methods:
Analysis was performed using SplitsTree App 6.0.0 (Huson and Bryant 2024).
The original input consisted of 7 taxa and 7 DNA sequences of length 56.
The Median Joining method (Bandelt et al 1999) was used (default options) so as to obtain 9 nodes and 11 edges.
The Razor Haplo Net method was used (default options) so as to obtain 12 nodes and 12 edges.

References:
Bandelt et al 1999: HJ Bandelt, P. Forster, and A. Röhl. Median-joining networks for inferring intraspecific phylogenies. Molecular Biology and Evolution, 16:37–48, 1999.
Huson and Bryant 2024: D.H. Huson and D. Bryant. The SplitsTree App: interactive analysis and visualization using phylogenetic trees and networks. Nature Methods, 2024.
]

BEGIN TAXA;
TITLE 'Input Taxa';
DIMENSIONS ntax=7;
TAXLABELS
	[1] 'seq_1'
	[2] 'seq_2'
	[3] 'seq_3'
	[4] 'seq_4'
	[5] 'seq_5'
	[6] 'seq_6'
	[7] 'seq_7'
;
[DISPLAYLABELS;]
[TAXINFO;]
END; [TAXA]

BEGIN TRAITS;
TITLE 'Input Traits';
DIMENSIONS [nTax=7] nTraits=5;
FORMAT labels=yes missing=? separator=Comma;
TRAITLATITUDE 53.0 43.6811 5.4 -25.61 -0.0;
TRAITLONGITUDE 16.75 87.3311 26.5 134.355 -76.0;
TRAITLABELS
 'Europe' 'Asia' 'Africa' 'Australia' 'America';
MATRIX
[1] 'seq_1'  0,0,0,3,3
[2] 'seq_2'  10,5,0,6,0
[3] 'seq_3'  0,0,0,3,5
[4] 'seq_4'  0,0,0,4,2
[5] 'seq_5'  4,0,10,0,0
[6] 'seq_6'  0,0,0,7,3
[7] 'seq_7'  0,0,5,0,0
;
END; [TRAITS]

BEGIN ALGORITHM;
TITLE 'Taxa Filter';
NAME 'Taxa Filter';
OPTIONS
;
END; [ALGORITHM]

BEGIN TAXA;
TITLE 'Working Taxa';
LINK ALGORITHM = 'Taxa Filter';
DIMENSIONS ntax=7;
TAXLABELS
	[1] 'seq_1'
	[2] 'seq_2'
	[3] 'seq_3'
	[4] 'seq_4'
	[5] 'seq_5'
	[6] 'seq_6'
	[7] 'seq_7'
;
[DISPLAYLABELS;]
[TAXINFO;]
END; [TAXA]

BEGIN TRAITS;
TITLE 'Working Traits';
LINK ALGORITHM = 'Taxa Filter';
DIMENSIONS [nTax=7] nTraits=5;
FORMAT labels=yes missing=? separator=Comma;
TRAITLATITUDE 53.0 43.6811 5.4 -25.61 -0.0;
TRAITLONGITUDE 16.75 87.3311 26.5 134.355 -76.0;
TRAITLABELS
 'Europe' 'Asia' 'Africa' 'Australia' 'America';
MATRIX
[1] 'seq_1'  0,0,0,3,3
[2] 'seq_2'  10,5,0,6,0
[3] 'seq_3'  0,0,0,3,5
[4] 'seq_4'  0,0,0,4,2
[5] 'seq_5'  4,0,10,0,0
[6] 'seq_6'  0,0,0,7,3
[7] 'seq_7'  0,0,5,0,0
;
END; [TRAITS]

BEGIN CHARACTERS;
TITLE 'Input Characters';
LINK ALGORITHM = 'Taxa Filter';
DIMENSIONS ntax=7 nchar=56;
FORMAT
	datatype='DNA' missing=? matchChar=. gap=- symbols="acgt" labels=left transpose=no interleave=no;
MATRIX
seq_1 atatacggggtta---ttaga----aaaatgtgtgtgtgttttttttttcatgtgg
seq_2 ......--..a........c......g...c.a...c..c...c............
seq_3 ..........a........t......g.............................
seq_4 ..........a.....g...t..................................a
seq_5 ..........a.....g...g..................................c
seq_6 ..........a.....g...c..................................t
seq_7 ..........a.....g......................................a
;
END; [CHARACTERS]

BEGIN ALGORITHM;
TITLE 'Input Data Filter';
LINK CHARACTERS = 'Input Characters';
NAME 'Characters Taxa Filter';
OPTIONS
;
END; [ALGORITHM]

BEGIN CHARACTERS;
TITLE 'Working Characters';
LINK ALGORITHM = 'Input Data Filter';
DIMENSIONS ntax=7 nchar=56;
FORMAT
	datatype='DNA' missing=? matchChar=. gap=- symbols="acgt" labels=left transpose=no interleave=no;
MATRIX
seq_1 atatacggggtta---ttaga----aaaatgtgtgtgtgttttttttttcatgtgg
seq_2 ......--..a........c......g...c.a...c..c...c............
seq_3 ..........a........t......g.............................
seq_4 ..........a.....g...t..................................a
seq_5 ..........a.....g...g..................................c
seq_6 ..........a.....g...c..................................t
seq_7 ..........a.....g......................................a
;
END; [CHARACTERS]

BEGIN ALGORITHM;
TITLE 'Median Joining';
LINK CHARACTERS = 'Working Characters';
NAME 'Median Joining';
OPTIONS
	Epsilon = 0;
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Razor Haplo Net';
LINK CHARACTERS = 'Working Characters';
NAME 'Razor Haplo Net';
OPTIONS
	AmbiguityHandling = 'Wildcard',
	ContractEdges = 'false',
	RemoveEdges = 'false',
	Polish = 'true',
	LocalPruning = 'true';
END; [ALGORITHM]

BEGIN NETWORK;
TITLE 'Network';
LINK ALGORITHM = 'Median Joining';
DIMENSIONS nVertices=9 nEdges=11;
TYPE HaplotypeNetwork;
PROPERTIES info ='Median-joining network';
VERTICES
	id=1 label='seq_7' x='6119.7594' y='2.6367' label='seq_7' states='atatacggggata---gtaga----aaaatgtgtgtgtgttttttttttcatgtga',
	id=2 label='seq_6' x='5992.7083' y='-30.4084' label='seq_6' states='atatacggggata---gtagc----aaaatgtgtgtgtgttttttttttcatgtgt',
	id=3 x='6026.3519' y='-6.7675' states='atatacggggata---gtagc----aaaatgtgtgtgtgttttttttttcatgtga',
	id=4 label='seq_4' x='6049.8218' y='10.2376' label='seq_4' states='atatacggggata---gtagt----aaaatgtgtgtgtgttttttttttcatgtga',
	id=5 label='seq_3' x='6372.6604' y='-15.9291' label='seq_3' states='atatacggggata---ttata----agaatgtgtgtgtgttttttttttcatgtgg',
	id=6 label='seq_1' x='6246.2147' y='-6.8727' label='seq_1' states='atatacggggtta---ttaga----aaaatgtgtgtgtgttttttttttcatgtgg',
	id=7 label='seq_2' x='6499.0981' y='-23.6899' label='seq_2' states='atatacggggata---ttaca----agaatctatgtctgctttctttttcatgtgg',
	id=8 x='5974.2522' y='22.5723' states='atatacggggata---gtagg----aaaatgtgtgtgtgttttttttttcatgtga',
	id=9 label='seq_5' x='5858.0981' y='48.4908' label='seq_5' states='atatacggggata---gtagg----aaaatgtgtgtgtgttttttttttcatgtgc'
;
EDGES
	id=1 sid=1 tid=3 sites='21',
	id=2 sid=1 tid=4 sites='21',
	id=3 sid=1 tid=8 sites='21',
	id=4 sid=2 tid=3 sites='56',
	id=5 sid=3 tid=4 sites='21',
	id=6 sid=3 tid=8 sites='21',
	id=7 sid=4 tid=8 sites='21',
	id=8 sid=8 tid=9 sites='56',
	id=9 sid=1 tid=6 sites='11,17,56',
	id=10 sid=5 tid=6 sites='11,20,27',
	id=11 sid=5 tid=7 sites='20,31,33,37,40,44'
;
END; [NETWORK]

