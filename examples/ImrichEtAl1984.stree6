BEGIN ALGORITHM;
TITLE 'Razor Net';
LINK DISTANCES = 'Working Distances';
NAME 'Razor Net';
OPTIONS
	Preprocessing = 'None',
	Strategy = 'Both',
	SignificantDigits = 6,
	MaxSeconds = 60;
END; [ALGORITHM]

BEGIN NETWORK;
TITLE 'Network';
LINK ALGORITHM = 'Razor Net';
DIMENSIONS nVertices=30 nEdges=36;
TYPE DistanceNetwork;
VERTICES
	id=1 label='t1',
	id=2 label='t2',
	id=3 label='t3',
	id=4 label='t4',
	id=5 label='t5',
	id=6 label='t6',
