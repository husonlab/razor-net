BEGIN ALGORITHM;
TITLE 'Shave Filter';
LINK NETWORK = 'Network';
NAME 'Shave Filter';
OPTIONS
	Target = 'None',
	TargetValue = 0,
	Deviation = 'Auto',
	DeviationQuantilePercent = 100,
	ReportTable = 'true';
END; [ALGORITHM]

