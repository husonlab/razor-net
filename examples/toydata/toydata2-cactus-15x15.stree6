BEGIN ALGORITHM;
TITLE 'Neighbor Net';
LINK DISTANCES = 'Working Distances';
NAME 'Neighbor Net';
OPTIONS
	InferenceAlgorithm = 'ActiveSet';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Network Pruning';
LINK DISTANCES = 'Working Distances';
NAME 'Network Pruning';
OPTIONS
	Epsilon = 0.1,
	MinDistance = 0.001;
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Razor Net';
LINK DISTANCES = 'Working Distances';
NAME 'Razor Net';
OPTIONS
	Epsilon = 0.001,
	MinDistance = 0.1;
END; [ALGORITHM]

BEGIN SPLITS;
TITLE 'Splits';
LINK ALGORITHM = 'Neighbor Net';
DIMENSIONS ntax=15 nsplits=28;
FORMAT labels=no weights=yes confidences=no;
PROPERTIES fit=100 cyclic;
CYCLE 1 2 4 12 7 5 6 8 9 10 11 15 14 13 3;
