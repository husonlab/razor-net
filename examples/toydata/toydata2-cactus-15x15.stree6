BEGIN ALGORITHM;
TITLE 'Show Splits';
LINK SPLITS = 'Splits';
NAME 'Show Splits';
OPTIONS
	View = 'SplitNetwork';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Show Network';
LINK NETWORK = 'Network';
NAME 'Show Network';
OPTIONS
	View = 'Network';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Show Network-2';
LINK NETWORK = 'Network-2';
NAME 'Show Network';
OPTIONS
	View = 'Network';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'SplitNetwork';
LINK ALGORITHM = 'Show Splits';
NAME 'SplitNetwork';
INPUT 'SPLITS';
OPTIONS
	Diagram = 'Splits',
	Orientation = 'Rotate0Deg',
	Rooting = 'None',
	ZoomFactor = 0.55044962,
	FontScaleFactor = 1,
	RootAngle = 160,
	OutlineFill = 0xffe6b3ff,
	LabelSplitsBy = 'None',
	ShowQRCode = 'false';
END; [VIEW]

BEGIN VIEW;
TITLE 'Network';
LINK ALGORITHM = 'Show Network';
NAME 'Network';
INPUT 'SPLITS';
OPTIONS
	Diagram = 'Network',
	FontScaleFactor = 1,
	TraitLegend = 'False',
	TraitSize = 32,
	SitesStyle = 'Weights',
	Edits = 'mn:1:-44.95,-329.84' 'mn:2:-56.1,-299.14' 'mn:3:-56.36,-306.46' 'mn:4:-65.39,-257.36' 'mn:5:-226.32,-153.88' 'mn:6:-56.37,-237.58' 'mn:7:-246.12,-143.25' 'mn:8:-293.98,-0.6' 'mn:9:-301.05,-17.31' 'mn:10:-314.89,-5.51' 'mn:11:-273.9,-130.45' 'mn:12:-319.68,-150.8' 'mn:13:-339.25,-153.81' 'mn:14:-301.98,-136.72' 'mn:15:-342.82,-138.47' 'mn:16:-324.09,-132.2' 'mn:17:-14.1,-219.51' 'mn:18:50.23,-210.37' 'mn:19:24.54,-224.28';
