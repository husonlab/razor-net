BEGIN ALGORITHM;
TITLE 'Neighbor Net';
LINK DISTANCES = 'Working Distances';
NAME 'Neighbor Net';
OPTIONS
	InferenceAlgorithm = 'ActiveSet';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Razor Net';
LINK DISTANCES = 'Working Distances';
NAME 'Razor Net';
OPTIONS
	Polish = 'true',
	LocalPruning = 'false';
END; [ALGORITHM]

BEGIN ALGORITHM;
TITLE 'Razor Net_old';
LINK DISTANCES = 'Working Distances';
NAME 'Razor Net_old';
OPTIONS
	Polish = 'true',
	LocalPruning = 'true',
	MinEdgeLength = 0,
	Epsilon = 0.0000001,
	MinDistance = 0.0000001,
	Algorithm2 = 'false';
END; [ALGORITHM]

